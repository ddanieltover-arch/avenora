# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
.next/
out/

# Environment and secrets (CRITICAL: Never commit credentials)
# NOTE: api/index.js is committed — Vercel validates functions config against
# files present in the repo before buildCommand runs.
.env
.env*.local
.env.production
.env.staging
.env.test
!.env.example

# Cryptographic private keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Customer documents, KYC uploads, and temporary storage
uploads/
documents/
kyc-vault/
temp-uploads/
storage/

# Database artifacts, local dumps, and SQLite
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
prisma/*.db

# Testing and coverage
coverage/
.nyc_output/

# Logs and runtime diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

